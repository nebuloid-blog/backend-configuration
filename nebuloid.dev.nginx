server {
	# Use Port 443 over Port 80. This is Secure HTTPS.
	listen [::]:443 ssl ipv6only=on; # managed by Certbot
	listen 443 ssl; # managed by Certbot

	# DISABLED: The API doesn't have any HTML files.
	# root /var/www/api.nebuloid.dev/html;
	# index index.html index.htm index.nginx-debian.html;

	# Set valid server names.
	server_name api.nebuloid.dev;

	# Use NGinX as a "Reverse Proxy Server"
	location / {
		proxy_pass http://localhost:8080;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection 'upgrade';
		proxy_set_header Host $host;
		proxy_cache_bypass $http_upgrade;

		# Add CORS headers to allow cross-site requests.
		add_header 'Access-Control-Allow-Origin' '*' always; # See note below...
		add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
		add_header 'Access-Control-Allow-Headers' 'Origin, Content-Type, Accept, Authorization' always;

		# For 'Access-Control-Allow-Origin', we are using a wildcard, '*'.
		# This can be seen as a very permissive policy, but we must allow for the following:
		# - nebuloid.dev
		# - api.nebuloid.dev
		# - localhost:*
		# Rather than attempting some hacks to force it working, I'm just using the wildcard.
		# Many sites still use the wildcard here despite it not being best-practice.
		# In a word, this policy configuration is a mess...so I'm just not messing with it!
	}

	ssl_certificate /etc/letsencrypt/live/api.nebuloid.dev/fullchain.pem; # managed by Certbot
	ssl_certificate_key /etc/letsencrypt/live/api.nebuloid.dev/privkey.pem; # managed by Certbot
	include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
	# Port 80 indicates basic non-secure HTTP requests.
	listen 80;
	listen [::]:80;

	# Set valid server names.
	server_name api.nebuloid.dev;

	# We will want to redirect HTTP to HTTPS!
	if ($host = api.nebuloid.dev) {
		return 301 https://$host$request_uri;
	} # managed by Certbot

	# Bad domains are given "not found", as a fallback.
	return 404; # managed by Certbot
}
