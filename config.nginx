server {
	# Use Port 443 over Port 80. This is Secure HTTPS.
	listen [::]:443 ssl ipv6only=on; # managed by Certbot
	listen 443 ssl; # managed by Certbot

	# DISABLED: The API doesn't have any HTML files.
	# root /var/www/api.nebuloid.dev/html;
	# index index.html index.htm index.nginx-debian.html;

	# Set valid server names.
	server_name api.nebuloid.dev www.api.nebuloid.dev;

	location / {
		try_files $uri $uri/ =404;
	}

	ssl_certificate /etc/letsencrypt/live/api.nebuloid.dev/fullchain.pem; # managed by Certbot
	ssl_certificate_key /etc/letsencrypt/live/api.nebuloid.dev/privkey.pem; # managed by Certbot
	include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
	listen 80;
	listen [::]:80;

	if ($host = www.api.nebuloid.dev) {
		return 301 https://$host$request_uri;
	} # managed by Certbot

	if ($host = api.nebuloid.dev) {
		return 301 https://$host$request_uri;
	} # managed by Certbot

	server_name api.nebuloid.dev www.api.nebuloid.dev;

	return 404; # managed by Certbot
}
